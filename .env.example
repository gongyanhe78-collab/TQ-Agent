# Compose 项目与访问端口
COMPOSE_PROJECT_NAME=risk-master
# 默认启动核心服务与 Milvus 向量库；纯核心环境可改为 core
COMPOSE_PROFILES=vector
FRONTEND_PORT=8080
TZ=Asia/Shanghai

# 向量存储与 Milvus 配置
VECTOR_BACKEND=milvus
VECTOR_FALLBACK_BACKEND=chroma
MILVUS_PORT=19530
MILVUS_URI=http://milvus:19530
MILVUS_TOKEN=
MILVUS_DATABASE=default
MILVUS_TIMEOUT_SECONDS=10
MILVUS_DOCUMENT_COLLECTION=weather_document_chunks_v1
MILVUS_MEMORY_COLLECTION=weather_user_memories_v1
MILVUS_DENSE_TOP_K=30
MILVUS_SPARSE_TOP_K=30
MILVUS_RRF_K=60

# 可观测性：Jaeger 仅在 observability profile 下启动
JAEGER_UI_PORT=16686
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://jaeger:4318/v1/traces
OTEL_TRACES_SAMPLER_ARG=1.0

# PostgreSQL 本地开发凭据，部署前必须替换
POSTGRES_DB=risk
POSTGRES_USER=risk
POSTGRES_PASSWORD=change-me-local-postgres-password

# Redis 默认只在内网使用；如改为外部地址，请同步调整 REDIS_URL
REDIS_URL=redis://redis:6379/0
REDIS_CACHE_ENABLED=true
REDIS_CONTEXT_TTL_SECONDS=1800
REDIS_KEY_PREFIX=risk

# 鉴权配置；JWT 密钥必须替换为足够长的随机值
AUTH_JWT_SECRET=change-me-to-a-random-secret-at-least-32-bytes
AUTH_ACCESS_TTL_SECONDS=900
AUTH_REFRESH_TTL_SECONDS=604800
AUTH_REFRESH_COOKIE_NAME=refresh_token
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
CORS_ORIGINS=http://127.0.0.1:8080,http://localhost:8080

# 首个管理员仅在 migrate 容器启动时创建；两项留空表示跳过，重复启动不会修改已有密码
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=

# 模型服务配置，真实密钥只写入本机未跟踪的 .env
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_CHAT_MODEL=qwen-plus
DASHSCOPE_INTENT_MODEL=qwen-plus
DASHSCOPE_FOLLOWUP_MODEL=qwen-plus
DASHSCOPE_EMBEDDING_MODEL=text-embedding-v4
DASHSCOPE_RERANK_MODEL=qwen3-rerank
DASHSCOPE_RERANK_ENDPOINT=

# 首次导入历史 SQLite 时临时开启，完成后恢复 false
RUN_LEGACY_MIGRATION=false
LEGACY_MIGRATION_DRY_RUN=false
LEGACY_SQLITE_PATH=/legacy/sessions.sqlite3

# 开放域联网搜索：开放域问题直接调用普通聊天模型并启用联网搜索
WEB_SEARCH_ENABLED=true
WEB_SEARCH_FORCED=true
RAG_EMPTY_UPGRADE_WEB_SEARCH=true
RAG_MIN_SCORE=0
